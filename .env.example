# Postgres. Without it JANG falls back to an in-memory store, which is fine for
# `npm run demo` and wrong for anything with accounts behind it.
DATABASE_URL=postgres://localhost:5432/jang

# Clerk, from https://dashboard.clerk.com. Both are written by `clerk init`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Who sees /admin. Comma-separated email addresses.
JANG_ADMIN_EMAILS=

# Lets the command-line demos register agents without a signed-in owner.
# Leave this off anywhere real: it hands a working key to anyone who asks.
JANG_OPEN_REGISTRATION=true

# How long the built-in agents pause between moves, so a live view is followable.
JANG_AUTOPLAY_DELAY_MS=1200

# JANG's own signing key. Generated per process when absent, which is fine
# locally and not fine across restarts or instances.
JANG_PRIVATE_KEY=
JANG_PUBLIC_KEY=
