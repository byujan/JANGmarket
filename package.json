{
  "name": "jang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=65536 next dev -p ${PORT:-3939}",
    "build": "next build",
    "start": "NODE_OPTIONS=--max-http-header-size=65536 next start -p ${PORT:-3939}",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "verify": "tsx scripts/verify.ts",
    "misuse": "tsx scripts/misuse.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "mcp": "tsx mcp/server.ts",
    "demo:llm": "tsx scripts/demo-llm.ts",
    "hw7": "tsx scripts/hw7/run.ts",
    "hw7:all": "for s in 20261028 20261101 20261102; do for v in base fix option1 option2 fix+option1 fix+option2; do tsx scripts/hw7/run.ts --seed=$s --variant=$v > /dev/null || exit 1; done; done && tsx scripts/hw7/summarize.ts",
    "hw7:summary": "tsx scripts/hw7/summarize.ts",
    "hw7:llm": "tsx scripts/hw7/llm.ts",
    "check": "npm run typecheck && npm test && npm run demo && npm run verify && npm run misuse",
    "db:setup": "tsx scripts/db-setup.ts",
    "smoke:ui": "tsx scripts/ui-smoke.ts",
    "hw7:pdf": "bash scripts/hw7/build-pdf.sh",
    "market": "tsx scripts/market.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@clerk/nextjs": "^7.9.22",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
